# Instância Z-API só da Cell Tech. Este arquivo não leva valor.
# Sem ZAPI_CELL_TECH_INSTANCE_ID ou ZAPI_CELL_TECH_TOKEN o grupo não recebe.
# Não usa a instância main (ZAPI_MAIN_*) nem a poly (ZAPI_POLY_*).
# ZAPI_CELL_TECH_CLIENT_TOKEN vazio usa ZAPI_CLIENT_TOKEN como Client-Token.
ZAPI_CELL_TECH_INSTANCE_ID=
ZAPI_CELL_TECH_TOKEN=
ZAPI_CELL_TECH_CLIENT_TOKEN=
