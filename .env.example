# Instância Z-API só da Cell Tech. Este arquivo não leva valor.
# Sem ZAPI_CELL_TECH_INSTANCE_ID ou ZAPI_CELL_TECH_TOKEN o grupo não recebe.
# Não usa a instância main (ZAPI_MAIN_*) nem a poly (ZAPI_POLY_*).
# ZAPI_CELL_TECH_CLIENT_TOKEN vazio usa ZAPI_CLIENT_TOKEN como Client-Token.
ZAPI_CELL_TECH_INSTANCE_ID=
ZAPI_CELL_TECH_TOKEN=
ZAPI_CELL_TECH_CLIENT_TOKEN=

# MP4 público do GIF "como abrir a caixa". Sem esta URL o aviso sai só em texto.
# yury-imports.com, yuri-imports-py.com e imports-py.com não resolvem e o código recusa esses hosts.
# A loja é https://www.compras-yu.com.
# Depois do deploy do frontend, a Z-API precisa de uma URL https pública. O alias estável deste projeto:
# https://yuri-imports.vercel.app/filmagem/como-abrir-caixa.mp4
FILMAGEM_ZAPI_VIDEO_URL=

# Backup do MySQL para o R2. Sem valores reais.
DATABASE_URL=
BACKUP_R2_BUCKET=yuri-imports-db-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
BACKUP_KEY_PREFIX=mysql/
BACKUP_TIME_ZONE=America/Sao_Paulo
BACKUP_STALE_HOURS=26

# WhatsApp do dono. O número não fica neste arquivo.
BACKUP_ALERT_PHONE=
ZAPI_MAIN_INSTANCE_ID=
ZAPI_MAIN_TOKEN=
ZAPI_CLIENT_TOKEN=

# Mídia: leitura só de clayton-assets e escrita só do bucket de backup.
MEDIA_BACKUP_SOURCE_BUCKET=clayton-assets
MEDIA_BACKUP_DEST_BUCKET=yuri-imports-db-backups
MEDIA_BACKUP_SOURCE_R2_ACCESS_KEY_ID=
MEDIA_BACKUP_SOURCE_R2_SECRET_ACCESS_KEY=
MEDIA_BACKUP_DEST_R2_ACCESS_KEY_ID=
MEDIA_BACKUP_DEST_R2_SECRET_ACCESS_KEY=
# Vazio = copiar o bucket inteiro. Lista separada por vírgula restringe e falha se surgir pasta nova.
MEDIA_BACKUP_SOURCE_PREFIXES=
MEDIA_BACKUP_DEST_PREFIX=media/
# Vazio = sem expiração da mídia.
MEDIA_BACKUP_RETENTION_DAYS=

# Vigilante: token só de leitura do bucket de backup. Não reutiliza BACKUP_R2_*.
BACKUP_WATCHDOG_R2_ACCESS_KEY_ID=
BACKUP_WATCHDOG_R2_SECRET_ACCESS_KEY=
